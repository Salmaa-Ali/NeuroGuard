# Copy to .env (git-ignored) and fill in. Never commit .env or paste its contents in chat/issues.

# --- Shared hosted Postgres (team database) ---
# Use the JDBC form, not the postgres:// URI. Hosted providers usually require sslmode=require.
DB_URL=jdbc:postgresql://<host>:5432/<dbname>?sslmode=require
DB_USERNAME=<user>
DB_PASSWORD=<password>

# --- Frontend origin(s), comma-separated ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Local Docker Postgres only (docker-compose.yml). Omit DB_URL above to use localhost defaults. ---
# DB_NAME=neuroguard
# DB_PORT=5432
