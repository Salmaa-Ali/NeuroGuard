# Copy to .env (git-ignored) and fill in. Never commit .env or paste its contents in chat/issues.

# --- Shared hosted Postgres (team database) ---
# Use the JDBC form, not the postgres:// URI. Hosted providers usually require sslmode=require.
DB_URL=jdbc:postgresql://<host>:5432/<dbname>?sslmode=require
DB_USERNAME=<user>
DB_PASSWORD=<password>

# --- JWT ---
# At least 32 bytes. Generate: openssl rand -base64 48
# Required outside the dev profile; in dev, if unset, a random per-run key is used (tokens die on restart).
JWT_SECRET=
JWT_EXPIRY_MINUTES=60

# --- First admin (only used if no ADMIN exists yet; remove afterwards) ---
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Frontend origin(s), comma-separated ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Local Docker Postgres only (docker-compose.yml). Omit DB_URL above to use localhost defaults. ---
# DB_NAME=neuroguard
# DB_PORT=5432

# --- Scanner QA: days before the due date that count as DUE_SOON ---
SCANNER_QA_DUE_SOON_DAYS=30
